Accept 16-bit single plane surfaces in the three-plane encoder input.

Planes with two bytes per sample are read as R16 UNORM, as the P010 path does,
so a host can feed 10-bit 4:4:4 (or its own converted 4:2:0) at full precision.
Input wrapping only; no shader or bitstream changes.

diff --git a/metal/pyrowave_encoder.mm b/metal/pyrowave_encoder.mm
index c998476..09217b4 100644
--- a/metal/pyrowave_encoder.mm
+++ b/metal/pyrowave_encoder.mm
@@ -991,7 +991,7 @@ pyrowave_result upload_cpu_input(pyrowave_encoder encoder, const pyrowave_cpu_bu
 }
 
 // Wraps the caller's IOSurfaces: either one biplanar NV12 or P010 surface, or three
-// single plane R8 surfaces.
+// single plane R8 or R16 surfaces.
 pyrowave_result wrap_gpu_input(pyrowave_encoder encoder, const pyrowave_gpu_input *input,
                                InputTextures &wrapped)
 {
@@ -1092,8 +1092,17 @@ pyrowave_result wrap_gpu_input(pyrowave_encoder encoder, const pyrowave_gpu_inpu
 			if (!plane_matches(surface(i), 0, width, height))
 				return PYROWAVE_ERROR_INVALID_ARGUMENT;
 
+			// Single plane surfaces may carry 16-bit samples (e.g. 'L016'), read as R16 UNORM.
+			const size_t sample_bytes = IOSurfaceGetBytesPerElement(surface(i));
+			if (sample_bytes != 1 && sample_bytes != 2)
+			{
+				device->log("Input planes[%d] has %zu bytes per sample, expected 1 or 2.", i, sample_bytes);
+				return PYROWAVE_ERROR_INVALID_ARGUMENT;
+			}
+
 			wrapped.sampled[i] = wrapped.adopt(wrap_surface_plane(
-					device, surface(i), 0, MTLPixelFormatR8Unorm, width, height, false));
+					device, surface(i), 0, sample_bytes == 2 ? MTLPixelFormatR16Unorm : MTLPixelFormatR8Unorm,
+					width, height, false));
 
 			if (!wrapped.sampled[i])
 				return PYROWAVE_ERROR_OUT_OF_DEVICE_MEMORY;
diff --git a/metal/pyrowave_metal.h b/metal/pyrowave_metal.h
index 575cab9..ca47b4e 100644
--- a/metal/pyrowave_metal.h
+++ b/metal/pyrowave_metal.h
@@ -168,7 +168,8 @@ typedef struct pyrowave_cpu_buffer
 // IOSurface input for the encoder. Two layouts are accepted:
 //   - one biplanar NV12 or P010 surface in planes[0], with planes[1] and planes[2] NULL.
 //     P010 samples are read as 16-bit UNORM, so the 10-bit values are slightly scaled.
-//   - three single plane R8 surfaces, one per YUV component
+//   - three single plane R8 or R16 surfaces, one per YUV component. R16 samples are
+//     read as 16-bit UNORM, so the caller scales narrower samples to full range.
 // The library wraps these in MTLTextures itself, so the caller does not have to
 // match any particular pixel format or usage. For the NV12 case the chroma plane
 // is bound twice with different channel swizzles rather than being deinterleaved,
